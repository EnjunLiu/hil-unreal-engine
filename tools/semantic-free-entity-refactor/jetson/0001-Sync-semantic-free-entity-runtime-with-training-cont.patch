index 0000000..32c1801
--- /dev/null
+++ b/src/vla/test/test_semantic_free_guard.py
@@ -0,0 +1,30 @@
+"""Static gate: Jetson vla package must stay free of semantic entity tables."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+PKG = ROOT / "vla"
+
+FORBIDDEN = (
+    "ENTITY_SLOT_IDS",
+    "ENTITY_IDS",
+    "scenario_from_slot",
+    "_color_from_entity_id",
+    "target_red",
+    "target_blue",
+)
+
+
+def test_vla_package_has_no_semantic_entity_category_tables() -> None:
+    offenders: list[str] = []
+    for path in sorted(PKG.rglob("*.py")):
+        text = path.read_text(encoding="utf-8")
+        for token in FORBIDDEN:
+            if token in text:
+                offenders.append(f"{path.relative_to(ROOT)}:{token}")
+        if re.search(r"\bENTITY_COUNT\s*=", text):
+            offenders.append(f"{path.relative_to(ROOT)}:ENTITY_COUNT=")
+    assert not offenders, "semantic leftovers in vla/:\n" + "\n".join(offenders)
