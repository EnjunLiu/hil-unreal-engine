-        action = torch.where(
-            valid_mask.view(batch_size, 1), action, torch.zeros_like(action)
-        )
-        stop_logit = torch.where(
-            valid_mask.view(batch_size, 1),
-            stop_logit,
-            torch.full_like(stop_logit, cfg.invalid_stop_logit),
