-        raw_norm = torch.linalg.vector_norm(raw_action, dim=-1, keepdim=True)
-        radial_scale = torch.where(
-            raw_norm > 1.0e-6,
-            torch.tanh(raw_norm) / raw_norm.clamp_min(1.0e-6),
